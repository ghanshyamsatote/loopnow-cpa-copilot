# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored and must never be committed.

# --- Model provider ---
# Get a free key at https://aistudio.google.com/apikey (no credit card required)
GOOGLE_GENERATIVE_AI_API_KEY=
MODEL_PROVIDER=google
MODEL_NAME=gemini-3.6-flash

# --- Database (not used yet — the app currently uses an in-memory store) ---
# Kept here for forward-compatibility; see README "Known Limitations".
# DATABASE_URL=

# --- Observability (optional) ---
# OTEL_EXPORTER_OTLP_ENDPOINT=
